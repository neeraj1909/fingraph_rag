# Resolved 2026-10-26. Refresh deliberately and rerun Docker/SSE gates.
FROM ghcr.io/astral-sh/uv:0.9.22@sha256:2320e6c239737dc73cccce393a8bb89eba2383d17018ee91a59773df802c20e6 AS uv
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --extra orchestration --no-dev --no-editable \
    && groupadd --gid 10001 fingraph \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin fingraph \
    && mkdir /data && chown 10001:10001 /data
COPY scripts ./scripts
COPY tests/fixtures ./tests/fixtures
COPY evals ./evals
USER 10001:10001
ENV FINGRAPH_STATE_DIRECTORY=/data FINGRAPH_RUNTIME_MODE=live
EXPOSE 8000
# SQLite checkpoints/event replay have a single owning process per data directory.
CMD ["python", "-m", "uvicorn", "fingraph_rag.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
